# ==========================================================
# VERITY AI — CONFIGURAÇÃO DO BANCO DE DADOS (SEQUELIZE)
# ==========================================================

# Opção 1: URL de Conexão Direta (Recomendado para Neon, Supabase, Railway, Vercel Postgres)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/verity_db?sslmode=require
DATABASE_SSL=true

# Opção 2: Credenciais Individuais (Opcional)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=verity_ai
# DB_USER=postgres
# DB_PASSWORD=suasenha
# DATABASE_SSL=false

# NOTA: Se você não preencher nenhuma das variáveis acima, o Sequelize
# utilizará automaticamente o SQLite local em 'database/verity_ai.sqlite'
# para permitir testes e execução imediata sem necessidade de instalar o PostgreSQL!

