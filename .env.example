# ==============================================================
# VERITY AI — VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================
# Slogan: "Sua empresa. Seu computador. Sua IA."

# --------------------------------------------------------------
# 1. FRONTEND (Vite + React)
# --------------------------------------------------------------
# Deixe vazio para usar a rota relativa com proxy /api ou aponte para sua API no deploy
VITE_API_URL=

# --------------------------------------------------------------
# 2. BACKEND PRINCIPAL (Rust Axum)
# --------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
DATABASE_URL=database/verity_ai.sqlite
JWT_SECRET=verity_super_secret_jwt_key_2026_change_in_production
AUTOMATION_SERVICE_URL=http://127.0.0.1:5001

# Provedor de IA opcional (se vazio ou 'demo', usa o motor inteligente de demonstração)
AI_PROVIDER=demo
AI_API_KEY=

# --------------------------------------------------------------
# 3. SERVIÇO DE AUTOMAÇÃO (Python FastAPI)
# --------------------------------------------------------------
AUTOMATION_PORT=5001

# Configuração de E-mail (SMTP)
# Se não configurado, o sistema executa em modo de demonstração seguro
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app
SMTP_FROM=seu-email@gmail.com

# --------------------------------------------------------------
# 4. BANCO DE DADOS SEQUELIZE (PostgreSQL / Neon / Supabase)
# --------------------------------------------------------------
# Exemplo de URL de conexão para PostgreSQL na nuvem (Supabase, Neon, Railway)
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/verity_db?sslmode=require
DATABASE_SSL=true

